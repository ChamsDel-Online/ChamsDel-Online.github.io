{
  "version": 2,
  "routes": [
    {
      "src": "/products/soundaiadvisors/?",
      "status": 301,
      "headers": { "Location": "/advisory/" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/advisory/?",
      "dest": "/advisory/index.html"
    },
    {
      "src": "/products/?",
      "dest": "/products/index.html"
    },
    {
      "src": "/products/([^/]+)/?",
      "dest": "/products/$1/index.html"
    },
    {
      "src": "/blog/?",
      "dest": "/blog/index.html"
    },
    {
      "src": "/blog/([^/]+)/?",
      "dest": "/blog/$1/index.html"
    },
    {
      "src": "/tools/?",
      "dest": "/tools/index.html"
    },
    {
      "src": "/tools/([^/]+)/?",
      "dest": "/tools/$1/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
